diff --git a/routers/web/mailbox/mailbox.go b/routers/web/mailbox/mailbox.go
index a28b796b93..147e73e933 100644
--- a/routers/web/mailbox/mailbox.go
+++ b/routers/web/mailbox/mailbox.go
@@ -76,8 +76,7 @@ func List(ctx *context.Context) {
 		ctx.ServerError("ListMessages", err)
 		return
 	}
-	pager := context.NewPagination(total, pageSize, page, 5)
-	pager.AddParamFromRequest(ctx.Req)
+	pager := context.NewPagerBuilder(ctx).TotalCount(total).PerPageLimit(pageSize).CurPage(page).NavPageNum(5).Build()
 	ctx.Data["Messages"] = messages
 	ctx.Data["MailboxFolder"] = folder
 	ctx.Data["MailboxQuery"] = ctx.FormString("q")
diff --git a/templates/mailbox/view.tmpl b/templates/mailbox/view.tmpl
index a114b88f34..aabdc97329 100644
--- a/templates/mailbox/view.tmpl
+++ b/templates/mailbox/view.tmpl
@@ -15,10 +15,10 @@
 						<input type="hidden" name="action" value="delete">
 						<button class="ui basic button" type="submit">{{svg "octicon-trash"}} {{ctx.Locale.Tr "mailbox.delete"}}</button>
 					</form>
-					<form class="ui form" method="post" action="{{AppSubUrl}}/mail/{{.Message.ID}}/action">
+					<form class="ui form ignore-dirty" method="post" action="{{AppSubUrl}}/mail/{{.Message.ID}}/action" data-global-init="initMailboxMoveForm">
 						<input type="hidden" name="action" value="move">
 						<div class="inline field tw-m-0">
-							<select name="folder" class="ui dropdown" onchange="this.form.submit()">
+							<select name="folder" class="ui selection dropdown">
 								<option value="">{{ctx.Locale.Tr "mailbox.move_to"}}</option>
 								{{range .MailboxFolders}}{{if ne .Name $.Message.Folder}}<option value="{{.Name}}">{{.Name}}</option>{{end}}{{end}}
 							</select>
@@ -47,7 +47,7 @@
 						<h4>{{ctx.Locale.Tr "mailbox.attachments"}}</h4>
 						<div class="ui list">
 						{{range .Attachments}}
-							<a class="item" href="{{AppSubUrl}}/mail/{{$.Message.ID}}/attachment/{{.ID}}">{{svg "octicon-paperclip"}} {{.Filename}} <span class="muted">({{FileSize .Size}})</span></a>
+							<a class="item" href="{{AppSubUrl}}/mail/{{$.Message.ID}}/attachment/{{.ID}}">{{svg "octicon-paperclip"}} {{.Filename}} <span class="muted">({{FormatByteSize .Size}})</span></a>
 						{{end}}
 						</div>
 					{{end}}
diff --git a/web_src/js/features/mailbox.ts b/web_src/js/features/mailbox.ts
new file mode 100644
index 0000000000..10555bdbfe
--- /dev/null
+++ b/web_src/js/features/mailbox.ts
@@ -0,0 +1,7 @@
+import {registerGlobalInitFunc} from '../modules/observer.ts';
+
+export function initMailboxMoveForm() {
+  registerGlobalInitFunc('initMailboxMoveForm', (form: HTMLFormElement) => {
+    form.querySelector('select[name="folder"]')!.addEventListener('change', () => form.submit());
+  });
+}
