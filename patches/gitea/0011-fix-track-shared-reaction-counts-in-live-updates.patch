 package repo
 
 import (
+	"fmt"
 	"testing"
 	"time"
 
@@ -222,3 +223,24 @@ func TestIssueLiveServerStatesCanExcludePendingUpserts(t *testing.T) {
 	require.Len(t, states, 1)
 	assert.Equal(t, "issuecomment-10", states[0].Key)
 }
+
+func TestIssueLiveReactionStateIgnoresPickerAndTracksCounts(t *testing.T) {
+	const markup = `<div data-issue-live-snapshot><div id="issue-4" class="timeline-item">
+<div class="bottom-reactions">
+<div class="reaction-picker"><a data-reaction-content="laugh" data-has-reacted="false">picker</a></div>
+<a data-reaction-content="heart" data-has-reacted="true"><span class="reaction-count">%d</span></a>
+</div></div></div>`
+	previous, err := issueLiveParseSnapshot(fmt.Sprintf(markup, 1))
+	require.NoError(t, err)
+	require.Len(t, previous, 1)
+	assert.Equal(t, "heart:true:1", previous[0].ReactionState)
+
+	current, err := issueLiveParseSnapshot(fmt.Sprintf(markup, 2))
+	require.NoError(t, err)
+	assert.Equal(t, "heart:true:2", current[0].ReactionState)
+	states := []issueLiveClientState{{Key: "issue-4", ReactionState: previous[0].ReactionState}}
+	baseline := issueLiveInitialSnapshotStates(states, current)
+	operations, _ := issueLiveDiffSnapshot(baseline, current)
+	require.Len(t, operations, 1)
+	assert.Equal(t, "upsert", operations[0].Action)
+}
