+func (s *loginServer) Next(response []byte) ([]byte, bool, error) {
+	if response == nil {
+		return []byte("Username:"), false, nil
+	}
+	if !s.hasUsername {
+		s.username, s.hasUsername = string(response), true
+		return []byte("Password:"), false, nil
+	}
