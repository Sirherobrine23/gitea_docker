 .../js/features/comp/ComboMarkdownEditor.ts   |   7 +-
 web_src/js/features/dropzone.ts               |  30 ++--
 web_src/js/features/repo-issue-live.ts        |   5 +-
 web_src/js/issue-live.sharedworker.ts         | 128 ++++++++++++++++--
 web_src/js/modules/issue-live-worker.ts       |   4 +
 6 files changed, 168 insertions(+), 32 deletions(-)

