From 7d2136e541752a89de564f92f28e627a7f67872f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 24 Sep 2026 18:39:20 +0000
Subject: [PATCH 9/9] fix: keep pull request state in sync with live timeline
 updates

Render the live snapshot with the same data as the regular view (resolve
conversation permission and editorconfig), restore the "edited" menus which
the frontend adds to re-rendered comments, and reload the merge box when the
timeline changes so a merged pull request doesn't keep offering to merge.

Assisted-by: Claude Code:claude-opus-5-5
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 routers/web/repo/issue_live.go                     |    5 +++++
 routers/web/web.go                                 |    2 +-
 .../repo/issue/view_content/pull_merge_box.tmpl    |    2 +-
 web_src/js/features/repo-issue-content.ts          |    6 ++++--
 web_src/js/features/repo-issue-live.ts             |    8 ++++++++
 web_src/js/features/repo-issue-pull.ts             |    7 +++++--
 6 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/routers/web/repo/issue_live.go b/routers/web/repo/issue_live.go
index b702a483d9..4b7833b757 100644
--- a/routers/web/repo/issue_live.go
+++ b/routers/web/repo/issue_live.go
@@ -150,6 +150,11 @@ func prepareIssueLiveSnapshot(ctx *context.Context) (string, error) {
 	}
 	if issue.IsPull {
 		ctx.Data["BaseTarget"] = issue.PullRequest.BaseBranch
+		canMarkConversation, err := issues_model.CanMarkConversation(ctx, issue, ctx.Doer)
+		if err != nil {
+			return "", err
+		}
+		ctx.Data["CanMarkConversation"] = canMarkConversation
 	}
 
 	prepareIssueViewCommentsAndSidebarParticipants(ctx, issue)
